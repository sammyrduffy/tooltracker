<%- include('../partials/head', { title: 'Overdue tools' }) %>

<h1>Overdue tools</h1>

<p class="muted">Checked-out tools (not at home base) whose beacon hasn't been detected in the last 2 days.</p>

<% if (items.length === 0) { %>
  <div class="card card--center">
    <p class="muted">No overdue tools right now.</p>
  </div>
<% } else { %>
  <table class="table">
    <thead>
      <tr>
        <th>Tool</th>
        <th>Who has it</th>
        <th>Site</th>
        <th>Beacon last seen</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) { %>
        <tr>
          <td><a href="/t/<%= item.short_id %>"><strong><%= item.tool_name %></strong></a></td>
          <td><%= item.employee_name %></td>
          <td><%= item.site_name || '—' %></td>
          <td class="nowrap"><%= h.formatDateTime(item.beacon_last_seen) %> <span class="muted">(<%= h.durationSince(item.beacon_last_seen) %> ago)</span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/foot') %>
