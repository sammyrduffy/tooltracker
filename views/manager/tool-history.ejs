<%- include('../partials/head', { title: tool.name + ' — history' }) %>

<div class="page-head">
  <h1><%= tool.name %> — history</h1>
  <a class="btn btn-ghost" href="/manager/tools">← Tools</a>
</div>

<p class="muted">
  Status: <span class="badge badge--<%= tool.status %>"><%= h.STATUS_LABELS[tool.status] %></span>
  · Code <code><%= tool.short_id %></code>
  · <a href="/t/<%= tool.short_id %>">Open tool page</a>
</p>

<% if (history.length === 0) { %>
  <div class="card card--center"><p class="muted">This tool has never been signed out yet.</p></div>
<% } else { %>
  <table class="table">
    <thead><tr><th>Employee</th><th>Site</th><th>Out</th><th>In</th><th>Duration</th></tr></thead>
    <tbody>
      <% history.forEach(function(c) { %>
        <tr>
          <td><%= c.employee_name %></td>
          <td><%= c.site_name || '—' %></td>
          <td><%= h.formatDateTime(c.time_out) %></td>
          <td><% if (c.time_in) { %><%= h.formatDateTime(c.time_in) %><% } else { %><span class="badge badge--signed_out">Still out</span><% } %></td>
          <td><%= h.durationSince(c.time_out, c.time_in) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <p class="muted small"><%= history.length %> checkout<%= history.length === 1 ? '' : 's' %> total.</p>
<% } %>

<%- include('../partials/foot') %>
